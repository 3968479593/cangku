# ===== 应用基础 =====
APP_NAME=AI电商选品助手
DEBUG=true

# ===== MySQL（先运行 backend/scripts/init_db.py 建表） =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ecommerce_rag
# 可选：填了就用它覆盖上面 5 项
# DATABASE_URL=mysql+pymysql://root:pass@localhost:3306/ecommerce_rag

# ===== LLM（OpenAI 兼容接口，如 DeepSeek / DashScope / OpenAI） =====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-chat

# ===== 本地嵌入/重排模型（先运行 backend/scripts/download_models.py 下载到 backend/models/） =====
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# ===== HuggingFace 镜像（国内网络可填 https://hf-mirror.com） =====
HF_ENDPOINT=